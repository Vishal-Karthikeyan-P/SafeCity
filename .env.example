# ============================================================
# SafeCity — Master Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://safecity:safecity_pass@localhost:5432/safecitydb
POSTGRES_USER=safecity
POSTGRES_PASSWORD=safecity_pass
POSTGRES_DB=safecitydb

# ----- Backend Security -----
SECRET_KEY=change-me-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- CORS -----
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# ----- File Storage -----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ----- Web Frontend -----
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_DEFAULT_LAT=40.7128
VITE_DEFAULT_LNG=-74.0060
VITE_DEFAULT_ZOOM=12

# ----- Mobile -----
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_DEFAULT_LAT=40.7128
EXPO_PUBLIC_DEFAULT_LNG=-74.0060

# ----- Email (optional) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@safecity.io

# ----- Gemini AI Chatbot (Backend only - never expose in frontend/mobile) -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=800
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=15.0
