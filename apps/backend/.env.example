# SafeCity Backend Environment Variables

APP_NAME=SafeCity
APP_VERSION=1.0.0
DEBUG=False

# PostgreSQL + PostGIS Connection
# Async URL used by FastAPI / asyncpg
DATABASE_URL=postgresql+asyncpg://safecity:safecity_pass@localhost:5432/safecitydb
# Sync URL used by Alembic / psycopg2
DATABASE_URL_SYNC=postgresql://safecity:safecity_pass@localhost:5432/safecitydb

# JWT & Security
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080","http://localhost"]

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Email / SMTP (required for Forgot Password OTP) ──────────────────────────
# SMTP server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMTP_USERNAME = the email address used to log in and send emails
SMTP_USERNAME=your-email@gmail.com

# SMTP_PASSWORD = your SMTP/account password. For Gmail, use an App Password
# (Account → Security → 2-Step Verification → App Passwords)
SMTP_PASSWORD=your-app-password-here

# SMTP_FROM_EMAIL = the address shown in the "From" field of sent emails
SMTP_FROM_EMAIL=your-email@gmail.com

# SMTP_FROM_NAME = the display name shown in the "From" field
SMTP_FROM_NAME=SafeCity

# OTP_EXPIRY_MINUTES = how many minutes before the OTP expires (default: 10)
OTP_EXPIRY_MINUTES=10
