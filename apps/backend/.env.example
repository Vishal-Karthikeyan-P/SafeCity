# SafeCity Backend Environment Variables

APP_NAME=SafeCity
APP_VERSION=1.0.0
DEBUG=False

# PostgreSQL + PostGIS Connection
# Async URL used by FastAPI / asyncpg
DATABASE_URL=postgresql+asyncpg://safecity:safecity_pass@localhost:5432/safecitydb
# Sync URL used by Alembic / psycopg2
DATABASE_URL_SYNC=postgresql://safecity:safecity_pass@localhost:5432/safecitydb

# JWT & Security
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080","http://localhost"]

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Email / SMTP (required for Forgot Password OTP) ──────────────────────────
# SMTP server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMTP_USERNAME = the email address used to log in and send emails
SMTP_USERNAME=your-email@gmail.com

# SMTP_PASSWORD = your SMTP/account password. For Gmail, use an App Password
# (Account → Security → 2-Step Verification → App Passwords)
SMTP_PASSWORD=your-app-password-here

# SMTP_FROM_EMAIL = the address shown in the "From" field of sent emails
SMTP_FROM_EMAIL=your-email@gmail.com

# SMTP_FROM_NAME = the display name shown in the "From" field
SMTP_FROM_NAME=SafeCity

# OTP_EXPIRY_MINUTES = how many minutes before the OTP expires (default: 10)
OTP_EXPIRY_MINUTES=10

# ── Gemini AI Chatbot (Backend only) ──────────────────────────
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_OUTPUT_TOKENS=800
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=15.0
CHATBOT_RATE_LIMIT_PER_MINUTE=20
CHATBOT_MAX_MESSAGE_LENGTH=600

# ── Severity AI Engine ────────────────────────────────────────
# Uses a SEPARATE Gemini API key so the severity engine has its own
# quota, independent from the chatbot (GEMINI_API_KEY above).
# Both keys can be obtained for free from: https://aistudio.google.com/
#
# Set SEVERITY_AI_ENABLED=false to skip AI entirely (pure rule-based, no cost).
# Set SEVERITY_AI_PREVIEW=false if you're on a free-tier daily cap and want
# AI to run only on final submission, not on every keystroke preview.
SEVERITY_AI_ENABLED=true
SEVERITY_AI_PREVIEW=true
SEVERITY_AI_PROVIDER=openai_compat
SEVERITY_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SEVERITY_AI_MODEL=gemini-1.5-flash
SEVERITY_AI_API_KEY=your_severity_gemini_api_key_here
