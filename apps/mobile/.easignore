# EAS Build Upload Ignore File
# Only the mobile Expo project root is uploaded.
# Exclude everything NOT required by the Expo / Android build.

# Dependencies (installed fresh on the build server)
node_modules/

# Version control
.git/
.gitignore

# EAS / Expo local caches
.expo/
.expo-shared/

# Local build output
dist/
build/
android/.gradle/
android/build/
android/app/build/
android/.cxx/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test files
__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
jest.config.*
jest.setup.*

# IDE / Editor
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Documentation
*.md
!README.md

# Backend
../../apps/backend/

# Web app
../../apps/web/

# Coverage / test artifacts
coverage/
.nyc_output/

# Storybook
.storybook/
storybook/
